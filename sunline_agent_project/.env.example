# ---------- Option A (recommended): hosted open-source models via Groq ----------
PROVIDER=openai_compat
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_your_key_here
MODEL=llama-3.3-70b-versatile

# ---------- Option B: OpenRouter (many models, one key) ----------
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# MODEL=<model id copied from openrouter.ai/models, filter: tool calling>

# ---------- Option C: Claude API (paid) ----------
# PROVIDER=anthropic
# MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=sk-ant-...

# ---------- Databases ----------
DATABASE_URL=sqlite:///demo.db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/sunline_copy
LOG_DATABASE_URL=sqlite:///agent_logs.db

# ---------- Knowledge base (week 2) ----------
KB_DATABASE_URL=sqlite:///kb.db
KB_DIR=knowledge
KB_MIN_SCORE=0.2
# hashing = zero setup, matches shared words only (development)
EMBED_PROVIDER=hashing
# Real semantic search, local (pip install fastembed). Check the model name with:
#   python -c "from fastembed import TextEmbedding; [print(m['model']) for m in TextEmbedding.list_supported_models()]"
# EMBED_PROVIDER=fastembed
# EMBED_MODEL=<a multilingual model from that list>
# Or a hosted embeddings API:
# EMBED_PROVIDER=api
# EMBED_BASE_URL=https://...
# EMBED_API_KEY=...
# EMBED_MODEL=...
